#RetroDevStudio.MetaData.BASIC:2049,BASIC V2,uppercase,10,10
10 PRINT "BBS CONFIG"
20 INPUT "NEW OR OLD";K$
30 IF LEFT$(K$,1)="N" THEN GOTO 1000
40 IF LEFT$(K$,1)="O" THEN GOTO 2000
1000 INPUT "CMD HDD DEVICE NUMBER ";K$
1010 HD$=K$
1011 INPUT "RAM-LINK DEVICE NUMBER";K$
1012 RL$=K$
1020 INPUT "CONFIG PARTITION";K$
1030 CO$=K$
1040 INPUT "BINARY PARTITION";K$
1050 BI$=K$
1060 INPUT "NUMBER OF BASE PARTITIONS";K$
1070 BA=VAL(K$)
1080 DIM BN$(BA)
1090 FOR X=1 TO BA
1100 INPUT "BASE ";K$
1110 BN$(X)=K$
1120 NEXT X
1135 REM SECRETLY EVERYTHING IS A DOOR
1140 INPUT "NUMBER OF DOORS";K$
1150 DO=VAL(K$)+2
1160 DIM DN$(DO,2)
1170 INPUT "WAITING FOR CALL PRG: ";DN$(1,1):DN$(1,2)="10"
1180 INPUT "LOGIN PRG: ";DN$(2,1):DN$(2,2)="10"
1190 IF DO=2 THEN GOTO 1230
1200 FOR X = 3 TO DO
1210 INPUT "DOOR PRG: ";DN$(X,1):INPUT "PRIV RQD";DN$(X,2)
1220 NEXT X
1230 REM END OF DOORS
2000 REM START OF OLD CONFIG
5000 PRINT "SAVING"
5010 OPEN 1,VAL(HD$),2,"@"+CO$+":CONFIG,S,W"
5020 PRINT#1,HD$
5030 PRINT#1,RL$
5040 PRINT#1,CO$
5050 PRINT#1,BI$
5060 PRINT#1,BA
5070 FOR X = 1 TO BA
5080 PRINT#1,BN$(X)
5090 NEXT X
5100 PRINT#1,DO
5110 FOR X = 1 TO DO
5120 PRINT#1,DN$(X,1):PRINT#1,DN$(X,2)
5130 NEXT X
5140 CLOSE1
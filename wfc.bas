701 REM  SUBROUTINE: SMART OPEN / RAMLINK CACHE
702 REM  IN:  F$  = FILENAME
703 REM       RL$ = RAMLINK DEVICE NUMBER STRING
704 REM       HD$ = CMD HD DEVICE NUMBER STRING
705 REM       PA$ = CMD HD PARTITION STRING
706 REM  OUT: CHANNEL 3 OPEN TO FILE F$
707 REM ==========================================
710 OPEN 3,VAL(RL$),3,F$+",S,R"
715 OPEN 15,VAL(RL$),15: INPUT#15,E: CLOSE 15
720 IF E=0 THEN RETURN :REM FILE EXISTS ON RL$, CHANNEL 3 READY
725 CLOSE 3
730 REM --- CHECK RAMLINK FREE SPACE ---
735 DV=VAL(RL$): P$=""
740 GOSUB 500 :REM RETURNS FP (FREE PERCENTAGE)
745 IF FP<=10 THEN 790 :REM LOW SPACE: OPEN DIRECTLY FROM HD
750 REM --- COPY FILE FROM HD TO RAMLINK ---
755 OPEN 2,VAL(HD$),2,PA$+":"+F$+",S,R"
760 OPEN 15,VAL(HD$),15: INPUT#15,E: CLOSE 15
765 IF E<>0 THEN CLOSE 2: PRINT "HD FILE MISSING": RETURN
770 OPEN 3,VAL(RL$),3,F$+",S,W"
775 GET#2,A$: B=ST
780 IF A$="" THEN A$=CHR$(0)
782 PRINT#3,A$;
784 IF B=0 THEN 775
786 CLOSE 2: CLOSE 3
788 OPEN 3,VAL(RL$),3,F$+",S,R": RETURN
790 REM --- SPACE <= 10%: OPEN DIRECTLY FROM HD ---
795 OPEN 3,VAL(HD$),3,PA$+":"+F$+",S,R": RETURN
800 REM ==========================================
801 REM  SUBROUTINE: FLUSH/COPY-BACK RAMLINK TO HD
802 REM  IN:  F$  = FILENAME
803 REM       RL$ = RAMLINK DEVICE NUMBER STRING
804 REM       HD$ = CMD HD DEVICE NUMBER STRING
805 REM       PA$ = CMD HD PARTITION STRING
806 REM  OUT: STATUS PRINTED IF ERROR OCCURS
807 REM ==========================================
810 OPEN 2,VAL(RL$),2,F$+",S,R"
815 OPEN 15,VAL(RL$),15: INPUT#15,E: CLOSE 15
820 IF E<>0 THEN CLOSE 2: PRINT "RL FILE MISSING": RETURN
825 REM --- SCRATCH EXISTING FILE ON HD PARTITION ---
830 OPEN 15,VAL(HD$),15,"S"+PA$+":"+F$: CLOSE 15
835 REM --- OPEN TARGET FILE ON CMD HD PARTITION FOR WRITING ---
840 OPEN 3,VAL(HD$),3,PA$+":"+F$+",S,W"
845 OPEN 15,VAL(HD$),15: INPUT#15,E: CLOSE 15
850 IF E<>0 THEN CLOSE 2: CLOSE 3: PRINT "HD WRITE ERROR": RETURN
855 REM --- BYTE-BY-BYTE COPY LOOP ---
860 GET#2,A$: B=ST
865 IF A$="" THEN A$=CHR$(0)
870 PRINT#3,A$;
875 IF B=0 THEN 860
880 CLOSE 2: CLOSE 3
885 RETURN

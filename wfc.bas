502 REM  SUBROUTINE: CHECK FREE BLOCKS & FREE %
503 REM  IN:  DV = DEVICE NUMBER (8-15)
504 REM       P$ = PARTITION STRING (E.G. "1" OR "")
505 REM  OUT: FB = FREE BLOCKS (-1 ON ERROR)
506 REM       TB = TOTAL BLOCKS ON DISK/PARTITION
507 REM       FP = FREE PERCENTAGE (0 TO 100)
508 REM ==========================================
510 FB=-1: TB=0: FP=0: DR$=""
515 IF P$<>"" THEN DR$=P$+":"
520 OPEN 2,DV,2,DR$+"$:"+CHR$(255)
525 IF ST<>0 THEN CLOSE 2: RETURN
530 GET#2,K$: GET#2,K$: GET#2,K$: GET#2,K$: GET#2,K$: GET#2,K$
545 GET#2,K$: IF K$<>"" AND ST=0 THEN 545
550 GET#2,K$: GET#2,K$
555 GET#2,L$: GET#2,H$
560 FB=ASC(L$+CHR$(0))+ASC(H$+CHR$(0))*256
565 GET#2,K$: IF K$<>"" AND ST=0 THEN 565
570 CLOSE 2
575 IF FB<0 THEN RETURN
580 REM --- QUERY TOTAL BLOCKS VIA CMD G-P COMMAND ---
585 IF P$="" THEN 620 :REM NO PARTITION, USE LEGACY FALLBACK
590 OPEN 15,DV,15,"G-P"+CHR$(VAL(P$))
595 GET#15,P1$: GET#15,PT$: GET#15,L$: GET#15,H$ :REM READ CMD PARTITION
600 CLOSE 15
605 TB=ASC(L$+CHR$(0))+ASC(H$+CHR$(0))*256
610 IF TB>0 THEN 650 :REM VALID CMD PARTITION TOTAL BLOCKS
620 REM --- FALLBACK TOTAL BLOCKS FOR LEGACY HARDWARE ---
625 TB=683  :REM 1541 TOTAL BLOCKS
630 IF FB>683 THEN TB=1366  :REM 1571 TOTAL BLOCKS
635 IF FB>1366 THEN TB=3200 :REM 1581 TOTAL BLOCKS
650 REM --- CALCULATE FREE PERCENTAGE ---
655 IF TB=0 THEN RETURN
660 FP=INT((FB/TB)*100)
665 IF FP>100 THEN FP=100
670 RETURN

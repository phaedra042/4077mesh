50 IF ST<>0 THEN PRINT "CONFIG ERROR": CLOSE 1: END
100 INPUT#1,HD$: PRINT "HD: ";HD$
110 INPUT#1,RL$: PRINT "RL: ";RL$
120 INPUT#1,CO$: PRINT "CO: ";CO$

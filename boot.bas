#RetroDevStudio.MetaData.BASIC:2049,BASIC V2,uppercase,10,10
5 C=PEEK(186): REM DYNAMICALLY DETECT BOOT DRIVE
6 POKE 49154,255
7 OPEN 15,C,15,"CP1":CLOSE15
10 REM --- LOAD SYSTEM CONFIG FROM BOOT DRIVE ---
100 OPEN 1,C,2,"CONFIG,S,R"
105 IF ST<>0 THEN PRINT "CONFIG READ ERROR": CLOSE 1: END
110 INPUT#1,HD$: PRINT "HD: ";HD$
120 INPUT#1,RL$: PRINT "RL: ";RL$
130 INPUT#1,CO$: PRINT "CO: ";CO$
140 INPUT#1,BI$: PRINT "BI: ";BI$
150 INPUT#1,K$: BA=VAL(K$)
160 DIM BN$(BA)
170 FOR X = 1 TO BA: INPUT#1,K$: BN$(X) = K$: NEXT X
210 INPUT#1,K$: DO=VAL(K$) :REM DO = DOOR COUNT
220 DIM DN$(DO,2)          :REM DN$(X,1)=FILE, DN$(X,2)=PERM
230 FOR X = 1 TO DO
240 INPUT#1,DN$(X,1): INPUT#1,DN$(X,2)
250 NEXT X
260 CLOSE 1
800 REM --- PERSIST BOOT VARIABLES IN LOW-RAM POINTERS ---
820 POKE 49152,VAL(HD$) :REM STORE HD DRIVE AT $C000
830 POKE 49153,VAL(CO$) :REM STORE CONFIG PART AT $C001
840 REM --- REFRESH BOOT BACKUP ON CONFIG PARTITION ---
842 OPEN 15,VAL(HD$),15,"S"+CO$+":BOOT": CLOSE 15
850 OPEN 15,VAL(HD$),15,"C"+CO$+":BOOT="+BI$+":BOOT": CLOSE 15
950 GOSUB 9000 :REM ENSURE USER.REL IS SYNCED ON RAMLINK
980 REM --- SWITCH CMD DRIVE TO BINARY PARTITION ---
985 OPEN 15,VAL(HD$),15,"CP"+BI$: CLOSE 15
990 REM --- LOAD WATCHDOG WITHOUT RESTARTING BASIC ---
991 POKE 780,0: POKE 781,VAL(HD$): POKE 782,1
992 SYS 57812 "WATCHDOG",VAL(HD$)
993 SYS 65493 :REM CALL KERNAL LOAD ($FFD5)

994 REM --- LOAD CHAINLOADER WITHOUT RESTARTING BASIC ---
995 POKE 780,0: POKE 781,VAL(HD$): POKE 782,1
996 SYS 57812 "CHAINLOAD",VAL(HD$)
997 SYS 65493 :REM CALL KERNAL LOAD ($FFD5)

998 REM --- LAUNCH PRIMARY SYSTEM SHELL (ENTRY 1) ---
999 REM LOAD DN$(1,1),VAL(HD$)
1000 FOR X = 1 TO LEN(DN$(1,1))
1010 POKE 49322+X,ASC(MID$(DN$(1,1),X,1)) 
1020 NEXTX
1040 POKE 49323+X,0
1030 SYS 49184

8999 END
9000 REM ==========================================
9001 REM  SUBROUTINE: ENSURE USER.REL ON RAMLINK
9002 REM  IN:  HD$ = HD DEV, RL$ = RL DEV, CO$ = PART
9003 REM ==========================================
9010 OPEN 3,VAL(RL$),3,"USER.REL,L,R,52"
9020 IF ST=0 THEN CLOSE 3: RETURN :REM EXISTS ON RL$
9030 CLOSE 3
9040 REM --- NOT ON RL$, CHECK HD PARTITION CO$ ---
9050 OPEN 3,VAL(HD$),3,CO$+":USER.REL,L,R,52"
9060 IF ST=0 THEN CLOSE 3: GOTO 9120 :REM FOUND ON HD
9070 CLOSE 3
9080 REM --- CREATE NEW ON HD PARTITION CO$ ---
9090 OPEN 3,VAL(HD$),3,CO$+":USER.REL,L,W,52"
9100 CLOSE 3
9110 REM --- COPY USER.REL FROM HD PARTITION TO RL ---
9120 OPEN 2,VAL(HD$),2,CO$+":USER.REL,L,R,52"
9130 OPEN 3,VAL(RL$),3,"USER.REL,L,W,52"
9140 GET#2,K$: B=ST
9150 IF K$="" THEN K$=CHR$(0)
9160 PRINT#3,K$;
9170 IF B=0 THEN 9140
9180 CLOSE 2: CLOSE 3: RETURN